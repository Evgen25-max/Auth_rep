PROJECT_NAME="Movie theater"
PROJECT_DESCRIPTION="The best movie theater for averyone"

DEBUG=True
SECRET_KEY=secretsecretsecret

CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ALLOWED_HOSTS = localhost,127.0.0.1,[::1]

SQL_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretsecretsecret
POSTGRES_DB=theatre
POSTGRES_HOST=theatre-db
POSTGRES_PORT=5432
POSTGRES_OPTIONS=-c search_path=public,content
DATABASE_TYPE=postgres

ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_SCHEMA=http://
# Ожидание при длительных сбоях контейнеров с базами.
FAILED_TIMEOUT=7
# Засыпание скрипта при ошибках
SLEEP_TIME=5
BATCH_SIZE=200

PROJECT_NAME_FASTAPI=movies

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSW=secretsecretsecret

